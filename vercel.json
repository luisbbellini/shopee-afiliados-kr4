{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/instagram",
      "destination": "/instagram.html"
    },
    {
      "source": "/api/instagram",
      "destination": "/api/instagram"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?route=:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "atendente-ig-kr4.vercel.app"
        }
      ],
      "destination": "/instagram",
      "permanent": false
    }
  ]
}
